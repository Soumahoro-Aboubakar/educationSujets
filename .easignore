# Dépôts de données volumineux, inutiles au build de l'application mobile
/new_files_unique/
/rendu_sans_filigrane/
/backend/
/frontend/

# Dépendances, caches et sorties générées, quel que soit leur emplacement
**/node_modules/
**/.expo/
**/.cache/
**/.metro/
**/dist/
**/build/
**/coverage/
**/tmp/
**/temp/

# Métadonnées et fichiers locaux
.git/
.vscode/
.claude/
**/*.log
.DS_Store
Thumbs.db

# Ne jamais envoyer les fichiers d'environnement ou clés locales
.env
.env.*
**/.env
**/.env.*
keys.text
**/keys.text

# Dossiers natifs générés localement (EAS les regénère à partir de app.json)
/fatafalta/ios/
/fatafalta/android/

# Sources des images générées (l'application n'utilise que leurs déclinaisons)
/fatafalta/assets/_generated/

# Documentation, notes personnelles et carnets : jamais envoyés à Expo
/docs/
/test.txt
/prompt_sujets.txt
/.impeccable/
**/*.ipynb
.ipynb_checkpoints/
.virtual_documents/
