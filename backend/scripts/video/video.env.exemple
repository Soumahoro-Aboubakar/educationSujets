# Modèle des secrets du pipeline vidéo (AUCUNE valeur réelle ici).
# Copier en backend/.env.video.local (ignoré par git : règle « .env.*.local ») puis remplir.

# Google Cloud > API et services > Identifiants > ID client OAuth « Application de bureau »
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Obtenu une seule fois avec : npm run video:auth
YOUTUBE_REFRESH_TOKEN=
# Identifiant de la chaîne (UC…) : le script refuse d'envoyer sur une autre chaîne
YOUTUBE_CHANNEL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Second fichier, séparé : backend/.env.production.local (ignoré par git), une seule ligne :
# MONGODB_URI=<URI de la base de PRODUCTION>
