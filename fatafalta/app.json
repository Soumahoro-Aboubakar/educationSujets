{
  "expo": {
    "name": "Fatafalta",
    "slug": "fatafalta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#0D1B32",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1B32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.fatafalta.mobile",
      "versionCode": 9,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fatafalta.com",
              "pathPrefix": "/sujets/document/"
            },
            {
              "scheme": "https",
              "host": "www.fatafalta.com",
              "pathPrefix": "/sujets/document/"
            },
            {
              "scheme": "https",
              "host": "fatafalta.onrender.com",
              "pathPrefix": "/sujets/document/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0D1B32"
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "visibility": "hidden",
          "behavior": "overlay-swipe"
        }
      ]
    ],
    "scheme": "fatafalta",
    "extra": {
      "eas": {
        "projectId": "7c6124e2-4b3e-4276-8e08-8313cda1f9ac"
      }
    }
  }
}
